{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emberhold",
  "version": "1.3.4",
  "identifier": "com.thevoidis999.emberhold",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emberhold \u2014 Living World Dungeon Crawler",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": true,
        "backgroundColor": "#0d141b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
